include LICENSE README.md
include aio_server_status/probe.sh
recursive-include aio_server_status/static *
recursive-include docs *.md *.png *.py
prune docs/_build
recursive-include scripts *.py *.sh
recursive-include fe/src *.ts *.tsx *.css
include fe/package.json fe/package-lock.json fe/tsconfig.json fe/vite.config.ts fe/index.html fe/README.md
include servers.example.yaml uv.lock .python-version
